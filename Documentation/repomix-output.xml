              >
                {departments.map((dept) => (
                  <option key={dept} value={dept}>
                    {dept}
                  </option>
                ))}
              </select>
            </div>

            {/* Symptoms Tags */}
            <div>
              <label className="font-bold text-light-primary block mb-2">
