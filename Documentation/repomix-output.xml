<file path="src/components/common/StatCard.tsx">
import React from 'react';

interface StatCardProps {
  label: string;
  value: string | number;
  subtext?: string;
  icon?: string; // Material symbol or Lucide name
  trend?: {
    value: string;
    isPositive?: boolean;
    label?: string;
  };
  variant?: 'default' | 'accent' | 'secondary' | 'danger' | 'success';
  className?: string;
  actionText?: string;
  onAction?: () => void;
}

export const StatCard: React.FC<StatCardProps> = ({
  label,
  value,
  subtext,
  icon,
  trend,
  variant = 'default',
  className = '',
  actionText,
  onAction
}) => {
  const getVariantStyles = () => {
    switch (variant) {
      case 'accent':
        return 'border-accent/40 bg-accent/5';
      case 'secondary':
        return 'border-secondary/30 bg-secondary/5';
      case 'danger':
        return 'border-danger/30 bg-danger/5';
      case 'success':
        return 'border-success/30 bg-success/5';
      default:
        return 'border-light-outline bg-light-surface';
    }
  };

  return (
    <div className={`p-5 rounded-xl border shadow-card transition-all hover:shadow-md ${getVariantStyles()} ${className}`}>
      <div className="flex items-start justify-between">
        <div>
          <span className="text-xs font-semibold uppercase tracking-wider text-light-on-surface-variant block mb-1">
            {label}
          </span>
          <div className="font-headline text-display-md-mobile sm:text-display-md font-extrabold text-light-primary tracking-tight font-code">
            {value}
          </div>
        </div>
        {icon && (
          <div className="w-10 h-10 rounded-lg bg-light-surface-variant border border-light-outline flex items-center justify-center text-light-primary">
            <span className="material-symbols-outlined text-xl text-secondary">{icon}</span>
          </div>
        )}
      </div>

      {(subtext || trend) && (
        <div className="mt-3 pt-3 border-t border-light-outline/60 flex items-center justify-between text-xs">
          {trend ? (
            <div className="flex items-center gap-1.5 font-medium">
              <span className={`inline-flex items-center font-bold font-code ${trend.isPositive ? 'text-success' : 'text-danger'}`}>
                {trend.value}
              </span>
              <span className="text-light-on-surface-variant">{trend.label || 'vs last hour'}</span>
            </div>
          ) : (
            <span className="text-light-on-surface-variant">{subtext}</span>
          )}

          {actionText && (
            <button
              onClick={onAction}
              className="text-secondary hover:underline font-semibold font-label flex items-center gap-0.5"
            >
              {actionText}
              <span className="material-symbols-outlined text-xs">chevron_right</span>
            </button>
          )}
        </div>
      )}
    </div>
  );
};
</file>

<file path="src/components/common/StatusBadge.tsx">
import React from 'react';
import { TokenStatus, PriorityLevel } from '../../types';

interface StatusBadgeProps {
  status?: TokenStatus | string;
  priority?: PriorityLevel;
  className?: string;
}

export const StatusBadge: React.FC<StatusBadgeProps> = ({ status, priority, className = '' }) => {
  if (priority) {
    switch (priority) {
      case 'Emergency':
        return (
          <span className={`inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-bold bg-danger/15 text-danger border border-danger/30 animate-pulse ${className}`}>
            <span className="w-1.5 h-1.5 rounded-full bg-danger"></span>
            EMERGENCY
          </span>
        );
      case 'Senior':
        return (
          <span className={`inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-bold bg-warning/15 text-on-warning border border-warning/30 ${className}`}>
            <span className="w-1.5 h-1.5 rounded-full bg-warning"></span>
            Senior Citizen
          </span>
        );
      case 'Pediatric':
        return (
          <span className={`inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-bold bg-secondary/15 text-secondary border border-secondary/30 ${className}`}>
            <span className="w-1.5 h-1.5 rounded-full bg-secondary"></span>
            Pediatric Child
          </span>
        );
      default:
        return (
          <span className={`inline-flex items-center gap-1 px-2 py-0.5 rounded text-xs font-medium bg-light-surface-variant text-light-on-surface-variant border border-light-outline ${className}`}>
            Standard OPD
          </span>
        );
    }
  }

  switch (status) {
    case 'IN_CONSULTATION':
      return (
        <span className={`inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-bold bg-secondary/15 text-secondary border border-secondary/30 ${className}`}>
          <span className="w-2 h-2 rounded-full bg-secondary animate-ping"></span>
          In Consultation
        </span>
      );
    case 'WAITING':
      return (
        <span className={`inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-accent/20 text-on-accent border border-accent/40 ${className}`}>
          <span className="w-1.5 h-1.5 rounded-full bg-accent"></span>
          Waiting in Queue
        </span>
      );
    case 'COMPLETED':
    case 'DISPENSED':
      return (
        <span className={`inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-success/15 text-success border border-success/30 ${className}`}>
          <span className="w-1.5 h-1.5 rounded-full bg-success"></span>
          Completed
        </span>
      );
    case 'SKIPPED':
      return (
        <span className={`inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-light-surface-variant text-light-on-surface-variant line-through ${className}`}>
          Skipped
        </span>
      );
    case 'PROCESSING':
    case 'DISPENSING':
      return (
        <span className={`inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-bold bg-warning/20 text-on-warning border border-warning/40 ${className}`}>
          <span className="w-1.5 h-1.5 rounded-full bg-warning animate-spin"></span>
          Processing
        </span>
      );
    case 'READY_FOR_PICKUP':
      return (
        <span className={`inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-bold bg-success/20 text-success border border-success/40 ${className}`}>
          <span className="w-1.5 h-1.5 rounded-full bg-success"></span>
          Ready for Pickup
        </span>
      );
    case 'CRITICAL':
      return (
        <span className={`inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-bold bg-danger text-white animate-bounce ${className}`}>
          CRITICAL ALERT
        </span>
      );
    default:
      return (
        <span className={`inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-medium bg-light-surface-variant text-light-on-surface-variant border border-light-outline ${className}`}>
          {status || 'Unknown'}
        </span>
      );
  }
};
</file>

