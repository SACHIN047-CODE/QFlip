rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user has clinical or staff role
    function isStaffOrDoctor() {
      return isAuthenticated() && (
        request.auth.token.role in ['doctor', 'admin', 'staff', 'lab', 'pharmacy']
      );
    }

    // Helper function to check if user owns this patient document
    function isOwner(patientEmail) {
      return isAuthenticated() && request.auth.token.email == patientEmail;
    }

    // Patients Collection:
    // - Authenticated users can read their own records
    // - Doctors/Staff can read and update patient records
    // - Only authorized clinical staff can delete records
    match /patients/{patientId} {
      allow read: if isStaffOrDoctor() || (isAuthenticated() && isOwner(resource.data.email));
      allow create: if isAuthenticated() || isStaffOrDoctor();
      allow update: if isStaffOrDoctor() || (isAuthenticated() && isOwner(resource.data.email));
      allow delete: if isAuthenticated() && request.auth.token.role == 'admin';
    }

    // Queue Tokens Collection:
    // - All authenticated hospital users can read queue tokens for real-time OPD flow
    // - Doctors and Registration staff can create and update tokens
    match /queue_tokens/{tokenId} {
      allow read: if true; // Public OPD screens can display token statuses
      allow create, update: if isAuthenticated() || isStaffOrDoctor();
      allow delete: if isStaffOrDoctor();
    }

    // Prescriptions Collection:
    // - Strict HIPAA / ABDM privacy: only the prescribing doctor or the patient can access
    match /prescriptions/{prescriptionId} {
      allow read: if isStaffOrDoctor() || (isAuthenticated() && request.auth.token.email == resource.data.patientEmail);
      allow create, update: if isAuthenticated() && request.auth.token.role == 'doctor';
      allow delete: if isAuthenticated() && request.auth.token.role == 'admin';
    }

    // Users Collection (Authentication & Profiles):
    // - Read allowed to verify user existence during login
    // - Create/Update allowed for patient (role="patient") and doctor (role="doctor") registrations
    match /users/{userId} {
      allow read, write: if true;
    }

    // Doctors Collection (Clinical Roster & Availability):
    match /doctors/{doctorId} {
      allow read, write: if true;
    }

    // Fallback: Deny all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
