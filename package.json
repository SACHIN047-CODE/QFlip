{
  "name": "qflip-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "server": "npm --prefix backend run dev",
    "server:start": "npm --prefix backend start",
    "seed": "npm --prefix backend run seed",
    "test:backend": "npm --prefix backend test",
    "start:all": "concurrently -n \"FRONTEND,BACKEND\" -c \"cyan,magenta\" \"npm run dev\" \"npm run server\"",
    "dev:all": "concurrently -n \"FRONTEND,BACKEND\" -c \"cyan,magenta\" \"npm run dev\" \"npm run server\""
  },
  "dependencies": {
    "axios": "^1.7.2",
    "clsx": "^2.1.1",
    "firebase": "^13.4.0",
    "lucide-react": "^0.395.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.51.5",
    "react-router-dom": "^7.18.6",
    "recharts": "^2.12.7",
    "tailwind-merge": "^2.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^10.0.7",
    "postcss": "^8.4.38",
    "repomix": "^1.19.0",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.4.5",
    "vite": "^8.3.8"
  }
}
